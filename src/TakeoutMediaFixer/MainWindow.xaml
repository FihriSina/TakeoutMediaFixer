<Window x:Class="TakeoutMediaFixer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Takeout Media Fixer"
        Width="920"
        Height="720"
        MinWidth="760"
        MinHeight="620"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BackgroundBrush}"
        AllowDrop="True"
        Drop="Window_Drop"
        DragOver="Window_DragOver">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#172033" Padding="28,22">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="Takeout Media Fixer"
                               Foreground="White"
                               FontFamily="Segoe UI Semibold"
                               FontSize="28" />
                    <TextBlock Text="Google Takeout fotoğraf ve videolarını tek sürükle-bırak işlemiyle düzenler."
                               Foreground="#CBD5E1"
                               FontFamily="Segoe UI"
                               FontSize="14"
                               Margin="0,6,0,0" />
                </StackPanel>
                <Border Grid.Column="1" Background="#24314A" CornerRadius="8" Padding="12,7" VerticalAlignment="Center">
                    <TextBlock Text="Kaynak dosyalar değiştirilmez"
                               Foreground="#A7F3D0"
                               FontFamily="Segoe UI Semibold"
                               FontSize="12" />
                </Border>
            </Grid>
        </Border>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="28">
                <Border x:Name="DropZone"
                        Background="{StaticResource CardBrush}"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="2"
                        CornerRadius="14"
                        Padding="28">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Cursor" Value="Hand" />
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="BorderBrush" Value="{StaticResource PrimaryBrush}" />
                                    <Setter Property="Background" Value="#F8FAFF" />
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="📁" FontSize="48" HorizontalAlignment="Center" />
                        <TextBlock x:Name="DropTitleText"
                                   Text="Klasörü buraya sürükleyip bırakın"
                                   FontFamily="Segoe UI Semibold"
                                   FontSize="20"
                                   Foreground="{StaticResource TextBrush}"
                                   Margin="0,12,0,0"
                                   HorizontalAlignment="Center" />
                        <TextBlock Text="Google Takeout klasörü, telefon yedeği veya karışık medya klasörü olabilir."
                                   FontFamily="Segoe UI"
                                   FontSize="13"
                                   Foreground="{StaticResource MutedTextBrush}"
                                   Margin="0,8,0,0"
                                   TextAlignment="Center" />
                        <Button x:Name="SelectFolderButton"
                                Content="Klasör Seç"
                                Margin="0,18,0,0"
                                Click="SelectFolderButton_Click" />
                    </StackPanel>
                </Border>

                <Border Background="{StaticResource CardBrush}"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="12"
                        Padding="20"
                        Margin="0,18,0,0">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock x:Name="StageText"
                                           Text="Bekliyor"
                                           FontFamily="Segoe UI Semibold"
                                           FontSize="15"
                                           Foreground="{StaticResource TextBrush}" />
                                <TextBlock x:Name="StatusText"
                                           Text="Bir klasör bıraktığınızda işlem otomatik başlayacaktır."
                                           FontFamily="Segoe UI"
                                           FontSize="13"
                                           Foreground="{StaticResource MutedTextBrush}"
                                           Margin="0,4,0,0"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                            <TextBlock x:Name="PercentageText"
                                       Grid.Column="1"
                                       Text="0%"
                                       FontFamily="Segoe UI Semibold"
                                       FontSize="15"
                                       Foreground="{StaticResource PrimaryBrush}"
                                       VerticalAlignment="Center" />
                        </Grid>

                        <ProgressBar x:Name="ProgressBar"
                                     Height="10"
                                     Minimum="0"
                                     Maximum="100"
                                     Value="0"
                                     Margin="0,14,0,0" />

                        <TextBlock x:Name="SourcePathText"
                                   Text=""
                                   FontFamily="Consolas"
                                   FontSize="11"
                                   Foreground="{StaticResource MutedTextBrush}"
                                   Margin="0,10,0,0"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <Grid Margin="0,18,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Background="White" CornerRadius="10" Padding="16" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="Fotoğraf" Foreground="{StaticResource MutedTextBrush}" FontSize="12" />
                            <TextBlock x:Name="ImagesText" Text="0" Foreground="{StaticResource TextBrush}" FontFamily="Segoe UI Semibold" FontSize="24" Margin="0,5,0,0" />
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="2" Background="White" CornerRadius="10" Padding="16" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="Video" Foreground="{StaticResource MutedTextBrush}" FontSize="12" />
                            <TextBlock x:Name="VideosText" Text="0" Foreground="{StaticResource TextBrush}" FontFamily="Segoe UI Semibold" FontSize="24" Margin="0,5,0,0" />
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="4" Background="White" CornerRadius="10" Padding="16" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="Meta veri yazıldı" Foreground="{StaticResource MutedTextBrush}" FontSize="12" />
                            <TextBlock x:Name="MetadataText" Text="0" Foreground="{StaticResource SuccessBrush}" FontFamily="Segoe UI Semibold" FontSize="24" Margin="0,5,0,0" />
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="6" Background="White" CornerRadius="10" Padding="16" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="Tarihi çözülemedi" Foreground="{StaticResource MutedTextBrush}" FontSize="12" />
                            <TextBlock x:Name="UnresolvedText" Text="0" Foreground="#B45309" FontFamily="Segoe UI Semibold" FontSize="24" Margin="0,5,0,0" />
                        </StackPanel>
                    </Border>
                </Grid>

                <Border Background="#EEF3FF" CornerRadius="10" Padding="16" Margin="0,18,0,0">
                    <TextBlock FontFamily="Segoe UI" FontSize="12.5" Foreground="#334155" TextWrapping="Wrap">
                        <Run FontWeight="SemiBold" Text="Otomatik işlemler: " />
                        <Run Text="Takeout JSON eşleştirme, mevcut EXIF/QuickTime tarihini koruma, dosya adından tarih çıkarma, hatalı uzantıyı düzeltme, aynı adlı dosyalara güvenli numara ekleme, fotoğraf ve videoları ayrı klasörlerde toplama ve CSV raporu oluşturma." />
                    </TextBlock>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="2" Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="28,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="Tüm işlem bilgisayarda yerel olarak yürütülür; dosyalar internete yüklenmez."
                           Foreground="{StaticResource MutedTextBrush}"
                           FontFamily="Segoe UI"
                           FontSize="12"
                           VerticalAlignment="Center" />
                <Button x:Name="CancelButton"
                        Grid.Column="1"
                        Content="İptal"
                        Style="{StaticResource SecondaryButton}"
                        IsEnabled="False"
                        Click="CancelButton_Click" />
                <Button x:Name="OpenOutputButton"
                        Grid.Column="3"
                        Content="Çıktı Klasörünü Aç"
                        Visibility="Collapsed"
                        Click="OpenOutputButton_Click" />
            </Grid>
        </Border>
    </Grid>
</Window>
